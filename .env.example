APP_PORT=8080
APP_BIND_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=fc26
POSTGRES_USER=fc26
POSTGRES_PASSWORD=fc26_local_change_me
# Leave empty to derive the URL from POSTGRES_* (including escaped passwords).
DATABASE_URL=
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_WORK_MEM=2MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_FLASH_ATTENTION=1
OLLAMA_NO_CLOUD=1
OLLAMA_MEMORY_LIMIT=3g
BACKEND_MEMORY_LIMIT=512m
DATABASE_MEMORY_LIMIT=256m
FRONTEND_MEMORY_LIMIT=64m
NGINX_MEMORY_LIMIT=64m
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_MB=10
ADB_ENABLED=true
ADB_DEFAULT_ADDRESS=host.docker.internal:5555
ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
SEED_DEMO=false
VITE_API_URL=/api
# Build provenance: set by the build caller, never account credentials.
BUILD_REVISION=unknown
BUILD_DATE=unknown
BUILD_ENVIRONMENT=local
BUILD_DIRTY=false
